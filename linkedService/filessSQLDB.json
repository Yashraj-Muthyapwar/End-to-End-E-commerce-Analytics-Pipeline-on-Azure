{
	"name": "filessSQLDB",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"description": "It pulls the data from the filess.io data source using the mysql.",
		"annotations": [],
		"type": "MySql",
		"typeProperties": {
			"server": "<your-mysql-host>",
			"port": "<your-mysql-port>",
			"database": "<your-mysql-database>",
			"username": "<your-mysql-username>",
			"sslMode": 1,
			"useSystemTrustStore": 0,
			"driverVersion": "v2",
			"encryptedCredential": "****************"
		}
	}
}
